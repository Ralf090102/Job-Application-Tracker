APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Vite dev-server origin for the frontend/ SPA — used by config/cors.php.
FRONTEND_URL=http://localhost:5173

# Phase 6: which origins get session-cookie auth instead of needing a
# bearer token — see config/sanctum.php. Must match FRONTEND_URL's host:port.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Phase 5 job-posting extraction — local Ollama, no API key needed.
# Defaults already match a stock `ollama serve` + `ollama pull mistral`.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# v2 Phase 2 — JSearch (RapidAPI) job search, used by JobSearchClient.
# Get a key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# v2 Phase 2 — shared-secret header the /api/auto-apply/ingest endpoint
# requires (it's a machine-to-machine endpoint n8n calls, not the SPA, so
# Sanctum's cookie auth doesn't apply here). Set to something random.
AUTO_APPLY_INGEST_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
