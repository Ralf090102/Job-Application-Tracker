# Base URL of the Laravel API. Vite only exposes env vars prefixed with
# VITE_ to client-side code. Default matches `php artisan serve`.
#
# Deliberately "localhost", not "127.0.0.1" (php artisan serve's own
# banner says 127.0.0.1, and both reach the same server) — Phase 6's
# XSRF-TOKEN cookie is scoped by hostname, not port, and the frontend
# itself runs on localhost:5173. A cookie set by 127.0.0.1 is invisible
# to document.cookie on a localhost page, even though it's the same
# machine — found live, as a real "CSRF token mismatch" on first login.
VITE_API_URL=http://localhost:8000
